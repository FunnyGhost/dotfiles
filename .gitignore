.DS_Store
Brewfile.lock.json
# Work-specific packages
Brewfile.local

# Environment secrets
.zshrc.local

# herdr runtime files (backstop: if stow ever folds ~/.config/herdr into the
# repo, the server's socket/logs land here — never commit them)
config/herdr/.config/herdr/*.sock
config/herdr/.config/herdr/*.log

# Work-specific Codex skills. These describe internal architecture (repo
# names, service topology), so they stay on disk and stow normally but are
# never committed to this public repo. See section 2 of CLAUDE.md.
config/codex/plugins/cthulhu-workflows/skills/learn-ip/
config/codex/plugins/cthulhu-workflows/skills/learn-sdk/
config/codex/plugins/cthulhu-workflows/commands/learn-ip.md
config/codex/plugins/cthulhu-workflows/commands/learn-sdk.md

# Codex writes plugin state into ~/.agents/plugins, which stow folds into this
# repo — backstop so that state never gets committed.
config/codex/.agents/plugins/*.lock.json
config/codex/.agents/plugins/.skill-lock.json

# Work-specific Claude slash commands — same rule as the Codex skills above:
# they name internal repos/services, so they stay local-only in ~/.claude/
# commands/ and are never committed. Backstop in case one is copied in here.
config/claude/.claude/commands/learn-ip.md
config/claude/.claude/commands/learn-sdk.md
