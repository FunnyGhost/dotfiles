.DS_Store
Brewfile.lock.json
# Work-specific packages
Brewfile.local

# Environment secrets
.zshrc.local

# herdr runtime files (backstop: if stow ever folds ~/.config/herdr into the
# repo, the server's socket/logs land here — never commit them)
config/herdr/.config/herdr/*.sock
config/herdr/.config/herdr/*.log

# Herdr.app writes these beside every mod (backstop: if stow ever folds a mod
# dir into the repo)
config/herdr-app/**/gpui-kit.d.ts
config/herdr-app/**/jsconfig.json

# Work-specific AI utilities. They describe internal architecture (repo
# names, service topology), so they stay on disk and stow normally but are
# never committed to this public repo. See section 2 of CLAUDE.md.
ai/learn-ip/
ai/learn-sdk/

# ~/.agents is stow-folded into this repo, so whatever tools install there lands
# here — backstop so that state never gets committed.
config/codex/.agents/plugins/*.lock.json
config/codex/.agents/plugins/.skill-lock.json
# Third-party skills, reinstalled by the commands in CLAUDE.md section 1.3.
config/codex/.agents/skills/
config/codex/.agents/.skill-lock.json

